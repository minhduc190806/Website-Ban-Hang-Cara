@model List<MinhDucWeb.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn";
    decimal subtotal = Model?.Sum(i => i.Total) ?? 0;
}

<!-- Page Header -->
<section id="page-header" class="about-header" style="background-image: url('/img/banner/b1.jpg'); padding: 60px 20px; text-align: center; color: #fff;">
    <h2 style="font-size: 38px; margin-bottom: 10px;">#Giỏ Hàng Của Bạn</h2>
    <p style="font-size: 16px;">Xem lại danh sách sản phẩm và tiến hành thanh toán</p>
</section>

@if (Model == null || !Model.Any())
{
    <div class="empty-cart-box">
        <i class="fa-solid fa-cart-arrow-down"></i>
        <h3>Giỏ hàng của bạn đang trống!</h3>
        <p style="color: #777; margin-bottom: 25px;">Chưa có sản phẩm nào được chọn. Hãy khám phá ngay các mẫu thời trang mới nhất.</p>
        <a asp-controller="Shop" asp-action="Index" class="normal" style="text-decoration: none; display: inline-block;">Khám Phá Cửa Hàng</a>
    </div>
}
else
{
    <section id="cart-items-section">
        <section id="cart" class="section-p1">
            <table width="100%">
                <thead>
                    <tr>
                        <td>Xóa</td>
                        <td>Hình Ảnh</td>
                        <td>Sản Phẩm</td>
                        <td>Đơn Giá</td>
                        <td>Số Lượng</td>
                        <td>Thành Tiền</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <form asp-controller="Cart" asp-action="Remove" method="post" style="display:inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="size" value="@item.Size" />
                                    <button type="submit" class="btn-remove-item" onclick="return confirm('Bạn có muốn xóa món này khỏi giỏ hàng?');">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </form>
                            </td>
                            <td><img src="~/@item.ImageUrl" alt="@item.ProductName"></td>
                            <td>
                                <strong>@item.ProductName</strong><br>
                                <small style="color:#777">Hãng: @item.Brand | Size: <span style="font-weight:700; color:#e94747">@item.Size</span></small>
                            </td>
                            <td>$@item.Price.ToString("N2")</td>
                            <td>
                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" style="display:flex; align-items:center; justify-content:center; gap:5px;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="size" value="@item.Size" />
                                    <input type="number" name="quantity" min="1" max="99" value="@item.Quantity" 
                                           style="width: 55px; padding: 6px; text-align: center; border: 1px solid #ccc; border-radius: 4px;">
                                    <button type="submit" class="btn-sm" style="background:#2c3e50; color:#fff; padding:6px 8px; border:none; border-radius:4px; cursor:pointer;" title="Cập nhật">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </form>
                            </td>
                            <td><strong style="color:#2c3e50">$@item.Total.ToString("N2")</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- Thao tác tổng giỏ hàng & Mã giảm giá -->
        <section id="cart-add" class="section-p1">
            <div id="coupon">
                <h3>Phiếu Giảm Giá</h3>
                <div>
                    <input type="text" placeholder="Nhập mã ưu đãi (Ví dụ: MINHDUC50)">
                    <button type="button" class="normal" onclick="alert('Áp dụng mã giảm giá MINHDUC50 thành công (Giảm 10%)!')">Áp Dụng</button>
                </div>
                <div style="margin-top: 25px;">
                    <form asp-controller="Cart" asp-action="Clear" method="post" style="display:inline;">
                        <button type="submit" class="btn-clear-cart" onclick="return confirm('Bạn có chắc muốn xóa tất cả sản phẩm trong giỏ không?');">
                            <i class="fa-regular fa-trash-can"></i> Xóa Rỗng Giỏ Hàng
                        </button>
                    </form>
                    <a asp-controller="Shop" asp-action="Index" style="margin-left: 15px; color: #555; text-decoration: underline; font-weight: 600;">
                        ← Mua thêm sản phẩm khác
                    </a>
                </div>
            </div>

            <div id="subtotal">
                <h3>Tổng Tiền Giỏ Hàng</h3>
                <table>
                    <tr>
                        <td>Tạm tính:</td>
                        <td>$@subtotal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>Phí vận chuyển:</td>
                        <td style="color: #2ecc71; font-weight: 700;">Miễn Phí (Freeship)</td>
                    </tr>
                    <tr class="total-row">
                        <td>Tổng thanh toán:</td>
                        <td>$@subtotal.ToString("N2")</td>
                    </tr>
                </table>
                <a asp-controller="Cart" asp-action="Checkout" class="btn-checkout">
                    Tiến Hành Đặt Hàng <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </section>
    </section>
}
