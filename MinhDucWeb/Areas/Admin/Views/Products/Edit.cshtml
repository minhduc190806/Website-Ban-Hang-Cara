@model MinhDucWeb.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chỉnh Sửa Sản Phẩm #{Model.Id}";
}

<div class="admin-header-bar">
    <div>
        <h1>Chỉnh Sửa Sản Phẩm #@Model.Id</h1>
        <p style="color: #666; margin-top: 5px;">Cập nhật thông tin chi tiết của sản phẩm</p>
    </div>
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn-sm btn-secondary">
        ← Quay lại danh sách
    </a>
</div>

<div class="admin-card" style="max-width: 800px;">
    <form asp-area="Admin" asp-controller="Products" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CreatedAt" />

        <div asp-validation-summary="ModelOnly" class="text-danger" style="color: #e74c3c; margin-bottom: 15px;"></div>

        <div class="form-group">
            <label asp-for="Name">Tên Sản Phẩm *</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger" style="color: #e74c3c;"></span>
        </div>

        <div style="display: flex; gap: 20px;">
            <div class="form-group" style="flex: 1;">
                <label asp-for="CategoryId">Danh Mục *</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories" required></select>
                <span asp-validation-for="CategoryId" class="text-danger" style="color: #e74c3c;"></span>
            </div>
            <div class="form-group" style="flex: 1;">
                <label asp-for="Brand">Thương Hiệu / Hãng *</label>
                <input asp-for="Brand" class="form-control" required />
                <span asp-validation-for="Brand" class="text-danger" style="color: #e74c3c;"></span>
            </div>
        </div>

        <div style="display: flex; gap: 20px;">
            <div class="form-group" style="flex: 1;">
                <label asp-for="Price">Giá Bán ($) *</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="Price" class="text-danger" style="color: #e74c3c;"></span>
            </div>
            <div class="form-group" style="flex: 1;">
                <label asp-for="OldPrice">Giá Gốc / Cũ ($)</label>
                <input asp-for="OldPrice" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="OldPrice" class="text-danger" style="color: #e74c3c;"></span>
            </div>
            <div class="form-group" style="flex: 1;">
                <label asp-for="Stock">Số Lượng Tồn Kho *</label>
                <input asp-for="Stock" type="number" class="form-control" required />
                <span asp-validation-for="Stock" class="text-danger" style="color: #e74c3c;"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="ImageUrl">Đường Dẫn Hình Ảnh *</label>
            <div style="display: flex; gap: 15px; align-items: center;">
                <img src="~/@Model.ImageUrl" style="width: 50px; height: 50px; border-radius: 4px; object-fit: cover;" alt="Preview" />
                <input asp-for="ImageUrl" class="form-control" style="flex: 1;" required />
            </div>
            <span asp-validation-for="ImageUrl" class="text-danger" style="color: #e74c3c;"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Mô Tả Chi Tiết Sản Phẩm</label>
            <textarea asp-for="Description" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger" style="color: #e74c3c;"></span>
        </div>

        <div style="display: flex; gap: 30px; margin: 20px 0;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
                <input asp-for="IsFeatured" type="checkbox" style="width: 18px; height: 18px;" />
                <span>Sản phẩm nổi bật (Featured)</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600;">
                <input asp-for="IsNewArrival" type="checkbox" style="width: 18px; height: 18px;" />
                <span>Hàng mới về (New Arrival)</span>
            </label>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 15px; border-top: 1px solid #edf2f7; padding-top: 20px;">
            <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn-sm btn-secondary">Hủy bỏ</a>
            <button type="submit" class="btn-sm btn-edit" style="padding: 10px 25px; font-size: 15px;">
                <i class="fa fa-save"></i> Cập Nhật Thay Đổi
            </button>
        </div>
    </form>
</div>
